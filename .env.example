# --- backend ---
DATABASE_URL=sqlite:///./data/docintel.db      # production: postgresql+psycopg2://user:pass@host:5432/docintel
STORAGE_DIR=./data/uploads
API_KEY=                                        # set to require X-API-Key on every /api call
CORS_ORIGINS=http://localhost:5173
WORKER_THREADS=4
MAX_UPLOAD_MB=200
ANTHROPIC_API_KEY=                              # empty => rule-based extractor is used
LLM_MODEL=claude-sonnet-5-5
EMBEDDING_PROVIDER=hash                         # or: sbert (pip install sentence-transformers)
OCR_DPI=200
OCR_MIN_CONFIDENCE=60
OCR_FIELD_MIN_CONFIDENCE=70                     # per-field OCR word-confidence gate (0-100)
